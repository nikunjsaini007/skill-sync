# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="http://localhost:3000/"

# JWT_SECRET: use a long random value in production; it signs SkillSync sessions.
JWT_SECRET="replace-with-a-long-random-secret-before-deploying"

# Firebase web app configuration (Firebase Console → Project settings → Your apps).
VITE_FIREBASE_API_KEY="AIzaSyAHo6AT8cpFYNBDIg2xBEh9xAZgwxD7GxY"
VITE_FIREBASE_AUTH_DOMAIN="skill-sync-985eb.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="skill-sync-985eb"
VITE_FIREBASE_STORAGE_BUCKET="skill-sync-985eb.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="247227622758"
VITE_FIREBASE_APP_ID="1:247227622758:web:48ed6c5138a58bcfe2d4a7"
