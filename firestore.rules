rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && userId == request.auth.uid;
    }

    function isParticipant(callerId, calleeId) {
      return isOwner(callerId) || isOwner(calleeId);
    }

    match /users/{userId} {
      allow read: if signedIn();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
      allow delete: if false;
    }

    match /connections/{connId} {
      allow read, update, delete: if signedIn() &&
        (resource.data.senderId == request.auth.uid ||
         resource.data.receiverId == request.auth.uid);
      allow create: if signedIn() && request.resource.data.senderId == request.auth.uid;
    }

    match /messages/{msgId} {
      allow read: if signedIn() && resource.data.participantIds.hasAny([request.auth.uid]);
      allow create: if signedIn() && request.resource.data.senderId == request.auth.uid;
      allow update: if signedIn() && resource.data.senderId == request.auth.uid &&
        request.resource.data.senderId == request.auth.uid;
      allow delete: if false;
    }

    match /calls/{callId} {
      allow read: if signedIn() && isParticipant(resource.data.callerId, resource.data.calleeId);
      allow create: if signedIn() && request.resource.data.callerId == request.auth.uid;
      allow update: if signedIn() && isParticipant(resource.data.callerId, resource.data.calleeId);
      allow delete: if signedIn() && isParticipant(resource.data.callerId, resource.data.calleeId);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
